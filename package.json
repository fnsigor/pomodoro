{
  "name": "focusflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "dev:web": "pnpm --filter focusflow-web dev",
    "dev:desktop": "pnpm --filter focusflow-desktop dev",
    "build:web": "pnpm --filter focusflow-web build",
    "build:desktop": "pnpm --filter focusflow-desktop build && pnpm --filter focusflow-desktop tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^3.0.5"
  }
}

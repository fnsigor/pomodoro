{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FocusFlow",
  "version": "0.1.0",
  "identifier": "br.com.focusflow.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FocusFlow",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 390,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4RUEwRTg3MUUxRTZGQ0UKUldUT2J4NGVodzdxZU10OWtMa1liVWJlRlFhWVB2eHRyV1FvRmhPdFlxcjhFWUxRcTh1d1A2VUIK",
      "endpoints": ["https://github.com/fnsigor/pomodoro/releases/latest/download/latest.json"]
    }
  }
}
